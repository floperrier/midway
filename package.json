{
  "name": "midway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --import-plugin --deny-warnings src scripts",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply midway-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply midway-db --remote",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "verify": "node scripts/verify.mjs",
    "setup:worktree": "bash scripts/setup-worktree.sh"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wrangler": "4.136.0"
  }
}
